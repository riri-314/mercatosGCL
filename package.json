{
  "name": "mercatosgcl",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "npm run test:typecheck && npm run test:frontend && npm run test:dev-security && npm run test:backend",
    "test:typecheck": "tsc --project tsconfig.test.json",
    "test:frontend": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:backend": "npm test --prefix functions",
    "test:dev-security": "node --test test/vite-security.test.mjs",
    "analyze:bundle": "node tooling/bundle-report.mjs",
    "test:bundle": "npm run build && node --test test/bundle-performance.test.mjs",
    "benchmark:browser": "node tooling/browser-performance.cjs",
    "test:browser": "node tooling/browser-smoke.cjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@faker-js/faker": "^10.6.0",
    "@iconify/react": "^6.0.3",
    "@mdxeditor/editor": "^4.3.4",
    "@mui/base": "5.0.0-beta.70",
    "@mui/icons-material": "^5.18.0",
    "@mui/lab": "5.0.0-alpha.177",
    "@mui/material": "^5.18.0",
    "@mui/system": "^5.18.0",
    "@mui/utils": "^5.17.1",
    "@mui/x-data-grid": "^6.20.4",
    "@mui/x-date-pickers": "^6.20.2",
    "browser-image-compression": "^2.0.2",
    "dayjs": "^1.11.23",
    "firebase": "^13.1.0",
    "lodash": "^4.18.1",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-images-uploading": "^3.1.7",
    "react-is": "^18.3.1",
    "react-lazy-load": "^4.0.1",
    "react-lazy-load-image-component": "^1.6.3",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "simplebar-react": "^3.3.2",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-lazy-load-image-component": "^1.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.26",
    "jsdom": "^30.1.3",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.6"
    },
    "react-is": "$react-is"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  }
