{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "build:watch": "tsc -w && cp src/*.json lib",
    "serve": "firebase serve --only functions",
    "start": "concurrently \"npm run build:watch\" \"npm run serve\"",
    "test": "npm run build && firebase emulators:exec --only firestore,auth --project demo-mercatos-security --config test/firebase.json \"node --test --test-concurrency=1 test/*.test.cjs\""
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^13.1.0",
    "firebase-functions": "^6.6.0",
    "firebase-tools": "^13.0.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.1.0",
    "typescript": "^5.3.3"
  },
  "private": true
}
