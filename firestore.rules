rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // An admin is a user whose email maps to their own uid in admin/admin.
    function isAdmin(uidE, email) {
      return uidE != null
        && email != null
        && get(/databases/$(database)/documents/admin/admin).data.admins[email].trim() == uidE.trim();
    }

    // Active editions are public; archived editions are readable only by admins.
    // All legitimate user writes (votes) go through Cloud Functions using the
    // Admin SDK, which bypasses these rules; direct client writes are admin-only.
    match /editions/{edition} {
      allow read: if resource.data.active == true
        || (request.auth != null && isAdmin(request.auth.uid, request.auth.token.email));
      allow write: if request.auth != null
        && isAdmin(request.auth.uid, request.auth.token.email);
    }

    // Admin mapping: readable (clients need it to know who is admin), but only
    // writable from the Firebase console / Admin SDK.
    match /admin/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Everything else denied by default.
  }
}
