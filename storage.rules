rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/admin/admin)
          .data.admins.get(request.auth.token.get('email', ''), null) == request.auth.uid;
    }

    function isActiveEdition(editionID) {
      return firestore.get(/databases/(default)/documents/editions/$(editionID))
        .data.get('active', false) == true;
    }

    match /{editionID}/{userID}/{fileName} {
      // Tokenized download URLs bypass rules. SDK reads of archived pictures
      // require an admin; edition-lock functions revoke their public tokens.
      allow get: if isAdmin() || isActiveEdition(editionID);
      allow list: if false;
      allow update, delete: if isAdmin();

      // Members can add new images, but cannot overwrite an existing object.
      allow create: if isAdmin() || (
        request.auth != null
        && request.auth.uid == userID
        && resource == null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && isActiveEdition(editionID)
      );
    }
  }
}
